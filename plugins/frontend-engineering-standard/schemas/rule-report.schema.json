{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tiantingrui/ai-marketplace/plugins/frontend-engineering-standard/schemas/rule-report.schema.json",
  "title": "Deterministic project rule report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capability",
    "repository",
    "range",
    "configuration",
    "summary",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "capability": {
      "const": "project-rules"
    },
    "repository": {
      "type": "string",
      "pattern": "\\S"
    },
    "range": {
      "type": "string",
      "pattern": "\\S"
    },
    "configuration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "loaded",
            "file"
          ],
          "properties": {
            "loaded": {
              "const": true
            },
            "file": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "loaded",
            "file"
          ],
          "properties": {
            "loaded": {
              "const": false
            },
            "file": {
              "const": null
            }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errors",
        "warnings",
        "info",
        "changedFiles",
        "changedLines"
      ],
      "properties": {
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        },
        "changedFiles": {
          "type": "integer",
          "minimum": 0
        },
        "changedLines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleId",
          "severity",
          "file",
          "line",
          "evidence",
          "message",
          "suggestion",
          "confidence"
        ],
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "\\S"
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "file": {
            "type": "string",
            "pattern": "\\S"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "evidence": {
            "type": "string",
            "pattern": "\\S"
          },
          "message": {
            "type": "string",
            "pattern": "\\S"
          },
          "suggestion": {
            "type": "string",
            "pattern": "\\S"
          },
          "confidence": {
            "enum": [
              "high",
              "medium"
            ]
          }
        }
      }
    }
  }
}
